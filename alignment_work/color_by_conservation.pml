# Conservation coloring script for 5YEL
# Generated by conservation_to_pymol.py

fetch 5YEL, async=0
remove solvent
remove (hetatm and not resn ZN)
as cartoon

# Reset all B-factors to 0
alter chain A, b=0.0

# Set B-factor = conservation score for each residue
